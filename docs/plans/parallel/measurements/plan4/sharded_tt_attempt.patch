+/// Write the given byte slices as one record (helper so the
+/// `for_each_entry` closures can stay infallible).
+fn write_record<W: Write>(w: &mut W, parts: &[&[u8]]) -> io::Result<()> {
+    for p in parts {
+        w.write_all(p)?;
+    }
+    Ok(())
+}
