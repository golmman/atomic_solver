+/// Lock each shard's buckets in index order and apply `f` (order-independent
+/// aggregate helper for `stats`/`best_child_counts`).
+fn for_each_bucket(shards: &[RwLock<Shard>], mut f: impl FnMut(&[TtEntry; 2])) {
