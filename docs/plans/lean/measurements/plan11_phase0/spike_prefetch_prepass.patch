+    /// Prefetch both cache lines the (unaligned, 112-byte) bucket `key` maps
+    /// to can straddle; no-op off aarch64.
+    #[inline(always)]
+    pub fn prefetch(&self, key: u64) {
+        let b = &self.table[self.index(key)];
+        let p = b as *const _ as *const u8;
+        #[cfg(target_arch = "aarch64")]
+        unsafe {
+            core::arch::asm!(
+                "prfm pldl1keep, [{0}]",
+                "prfm pldl1keep, [{1}]",
+                in(reg) p,
+                in(reg) p.wrapping_add(std::mem::size_of::<[TtEntry; 2]>() - 1),
+                options(nostack, readonly, preserves_flags)
+            );
+        }
+        #[cfg(not(target_arch = "aarch64"))]
+        let _ = p;
+    }
