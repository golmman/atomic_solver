+#[test]
+fn cut_context_never_schedule_is_bit_identical_and_terminates() {
+    // Plan14 termination guard: with an unbounded slice (`RestartSchedule::
+    // NEVER`, `restart_slice == u64::MAX`) the cut-context mechanism is
+    // disabled, so the run must be bit-identical to feature-off and must
+    // terminate on its own.
+    const FEN: &str = "4k3/8/8/8/8/8/8/4KRR1 w - - 0 1";
+
+    let run = |bits: Option<usize>| {
+        let mut pos = Position::from_fen(FEN).unwrap();
+        let mut search = Search::new(64);
+        search.set_timeout(60);
+        search.set_restart_schedule(RestartSchedule::NEVER);
+        if let Some(bits) = bits {
+            search.set_cut_context_bits_for_test(bits);
+        }
+        let (outcome, pv, _nodes) = search.search_depth(&mut pos, 3);
+        (outcome, pv.len(), search.child_evaluations())
+    };
+
+    let off = run(None);
+    let on = run(Some(12));
+    assert_eq!(on, off, "NEVER + cut-context must be bit-identical to off");
+}
+
+#[test]
+fn cut_context_liveness_on_a_quick_threshold_cut_case() {
+    // Plan14 liveness: dec02 is a 138k-eval loss proof whose threshold cuts
+    // repeat under identical contexts, so the table must produce hits and the
+    // decisive outcome must be unchanged.
+    const FEN: &str = "8/1k1p4/1P2p3/p2P1P2/P7/6p1/6K1/8 b - - 0 27";
+
+    let mut pos = Position::from_fen(FEN).unwrap();
+    let mut search = Search::new(64);
+    search.set_timeout(60);
+    search.set_cut_context_bits_for_test(20);
+    let (outcome, _pv, _nodes) = search.search_depth(&mut pos, u32::MAX);
+    assert_eq!(outcome, Outcome::Loss);
+    assert!(
+        search.cut_context_hits_for_test() > 0,
+        "the cut-context table must be consulted"
+    );
+}
