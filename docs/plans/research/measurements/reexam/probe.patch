 use crate::zobrist::INF;
 
+/// wpns arm: weak sum `INF if any v >= INF, else max + (k - 1)` with
+/// `k = #{v > 0}` (0 if k == 0).
+fn weak_sum(values: impl Iterator<Item = u64>) -> u64 {
+    let mut any_inf = false;
+    let mut max = 0u64;
+    let mut k = 0u64;
+    for v in values {
+        if v >= INF {
+            any_inf = true;
+        }
+        if v > 0 {
+            k += 1;
+        }
+        max = max.max(v);
+    }
+    if any_inf {
+        INF
+    } else if k == 0 {
+        0
+    } else {
+        max + (k - 1)
+    }
+}
+
+/// Parent (pn, dn) from the children table. `wpns` replaces the AND-side pn
+/// sum and the OR-side dn sum by the weak sum.
+fn parent_pn_dn(children: &[ChildInfo], is_or_node: bool, wpns: bool) -> (u64, u64) {
+    let (mut pn, mut dn) = if is_or_node { (INF, 0) } else { (0, INF) };
+    if is_or_node {
+        for c in children {
+            pn = std::cmp::min(pn, c.pn);
+            if !wpns {
+                dn = std::cmp::min(INF, dn.saturating_add(c.dn));
+            }
+        }
+        if wpns {
+            dn = weak_sum(children.iter().map(|c| c.dn));
+        }
+    } else {
+        for c in children {
+            dn = std::cmp::min(dn, c.dn);
+            if !wpns {
+                pn = std::cmp::min(INF, pn.saturating_add(c.pn));
+            }
+        }
+        if wpns {
+            pn = weak_sum(children.iter().map(|c| c.pn));
+        }
+    }
+    (pn, dn)
+}
