new file mode 100644
index 0000000..d1d944b
--- /dev/null
+++ b/examples/probe_solve.rs
@@ -0,0 +1,108 @@
+//! Probe driver: solve one FEN and emit a single JSON line with the run
+//! result and all `ProbeStats` counters.
+//!
+//!     probe_solve --fen <FEN> --tt <MB> [--depth <D>] [--budget <N>]
+
+use std::time::Instant;
+
+use atomic_solver::position::{Outcome, Position};
+use atomic_solver::search::dfpn::Search;
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let mut fen: Option<String> = None;
+    let mut tt_mb: usize = 128;
+    let mut depth: Option<u32> = None;
+    let mut budget: Option<u64> = None;
+
+    let mut i = 1;
+    while i < args.len() {
+        match args[i].as_str() {
+            "--fen" => {
+                fen = Some(args.get(i + 1).expect("--fen needs a value").clone());
+                i += 1;
+            }
+            "--tt" => {
+                tt_mb = args
+                    .get(i + 1)
+                    .expect("--tt needs a value")
+                    .parse()
+                    .expect("--tt must be a non-negative integer");
+                i += 1;
+            }
+            "--depth" => {
+                depth = Some(
+                    args.get(i + 1)
+                        .expect("--depth needs a value")
+                        .parse()
+                        .expect("--depth must be a non-negative integer"),
+                );
+                i += 1;
+            }
+            "--budget" => {
+                budget = Some(
+                    args.get(i + 1)
+                        .expect("--budget needs a value")
+                        .parse()
+                        .expect("--budget must be a non-negative integer"),
+                );
+                i += 1;
+            }
+            other => {
+                eprintln!("unknown option: {other}");
+                std::process::exit(2);
+            }
+        }
+        i += 1;
+    }
+
+    let fen = fen.expect("--fen is required");
+    let mut pos = Position::from_fen(&fen).expect("invalid FEN");
+
+    let mut search = Search::new(tt_mb);
+    search.set_timeout(3600);
+    search.set_first_outcome_only(true);
+    if let Some(b) = budget {
+        search.set_child_eval_budget(b);
+    }
+
+    let t0 = Instant::now();
+    let (outcome, pv, nodes) = match depth {
+        Some(d) => search.search_depth(&mut pos, d),
+        None => search.solve(&mut pos),
+    };
+    let wall_s = t0.elapsed().as_secs_f64();
+
+    let mut obj = serde_json::Map::new();
+    obj.insert("fen".into(), serde_json::Value::String(fen));
+    obj.insert("tt".into(), serde_json::json!(tt_mb));
+    obj.insert(
+        "depth".into(),
+        depth.map_or(serde_json::Value::Null, |d| serde_json::json!(d)),
+    );
+    obj.insert(
+        "outcome".into(),
+        serde_json::Value::String(
+            match outcome {
+                Outcome::Win => "win",
+                Outcome::Loss => "loss",
+                Outcome::Draw => "draw",
+            }
+            .to_string(),
+        ),
+    );
+    obj.insert("child_evals".into(), serde_json::json!(search.child_evaluations()));
+    obj.insert("nodes".into(), serde_json::json!(nodes));
+    obj.insert("pv_len".into(), serde_json::json!(pv.len()));
+    obj.insert(
+        "exit_reason".into(),
+        serde_json::Value::String(format!("{}", search.exit_reason())),
+    );
+    obj.insert("wall_s".into(), serde_json::json!(wall_s));
+    if let serde_json::Value::Object(stats) =
+        serde_json::to_value(search.probe_stats()).expect("probe stats serialize")
+    {
+        obj.extend(stats);
+    }
+    println!("{}", serde_json::Value::Object(obj));
+}
