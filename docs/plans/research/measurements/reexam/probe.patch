--- /dev/null
+++ b/src/search/probe.rs
@@ -0,0 +1,97 @@
+//! Probe instrumentation for measurement sessions (isolated copy only).
+//!
+//! `ProbeStats` holds the always-on counters (C1-C8, plus the R7 chunk
+//! counter); they are reset in `Search::begin_run`. The `*_arm`/`tt_salt`/
+//! `chunk0` helpers read the `PROBE_*` environment variables once per
+//! process; all defaults reproduce the unmodified baseline behavior.
+
+use std::sync::OnceLock;
+
+/// Exit-class indices for the C2/C4 per-class arrays.
+pub(crate) const XC_SOLVED: usize = 0;
+pub(crate) const XC_THRESHOLD: usize = 1;
+pub(crate) const XC_WORK: usize = 2;
+pub(crate) const XC_NOMOVE: usize = 3;
+pub(crate) const XC_TIME: usize = 4;
+pub(crate) const XC_COUNT: usize = 5;
+
+/// Per-run probe counters. `*_or` / `[0]` indexes are OR-node frames,
+/// `[1]` indexes are AND-node frames.
+#[derive(Clone, Copy, Debug, Default, serde::Serialize)]
+pub struct ProbeStats {
+    /// C1: `dfpn` frames that reached the main loop.
+    pub frames_loop: u64,
+    /// C2: loop-exit class counts/descendant evals, [OR, AND] per class.
+    pub exit_solved: [u64; 2],
+    pub exit_solved_evals: [u64; 2],
+    pub exit_threshold: [u64; 2],
+    pub exit_threshold_evals: [u64; 2],
+    pub exit_work: [u64; 2],
+    pub exit_work_evals: [u64; 2],
+    pub exit_nomove: [u64; 2],
+    pub exit_nomove_evals: [u64; 2],
+    pub exit_time: [u64; 2],
+    pub exit_time_evals: [u64; 2],
+    /// C3: threshold-cut breaks on the first loop iteration, [OR, AND];
+    /// `fresh` = subset whose entry TT probe missed.
+    pub first_sweep_cut: [u64; 2],
+    pub first_sweep_cut_evals: [u64; 2],
+    pub first_sweep_cut_fresh: [u64; 2],
+    /// C4: `explored = true` marks; frames with >=1 mark; evals spent in
+    /// those frames after the first mark, split by exit class.
+    pub explored_marks: u64,
+    pub explored_frames: u64,
+    pub explored_evals_after: [u64; XC_COUNT],
+    /// C5: suppressed-draw (1,1) stores; `clobbers` overwrote a live
+    /// unsolved TT entry whose (pn,dn) != (1,1).
+    pub suppress_draw_stores: u64,
+    pub suppress_draw_clobbers: u64,
+    /// C6: unsolved stores with pn == INF or dn == INF, [OR, AND]; `taint`
+    /// counts the AND subset having a repetition-seen Draw child.
+    pub inf_unsolved_stores: [u64; 2],
+    pub inf_unsolved_taint_and: u64,
+    /// C7: unsolved TT bound reuses in `evaluate_child` with pn or dn INF.
+    pub tt_bound_reuse_inf: u64,
+    /// C8: child recursions that returned solved but whose re-evaluated
+    /// child reports `outcome == None`; evals spent in the parent frame
+    /// after the first such event until frame exit.
+    pub stale_after_return: u64,
+    pub stale_evals_after: u64,
+    /// R7: work chunks executed by `bounded_search`.
+    pub chunks: u64,
+}
+
+fn env_eq(name: &str, val: &str) -> bool {
+    std::env::var(name).is_ok_and(|v| v == val)
+}
+
+fn env_u64(name: &str, default: u64) -> u64 {
+    std::env::var(name)
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(default)
+}
+
+/// `PROBE_INIT=mob`: mobility-based initialization of unsolved children.
+pub(crate) fn init_mob_arm() -> bool {
+    static F: OnceLock<bool> = OnceLock::new();
+    *F.get_or_init(|| env_eq("PROBE_INIT", "mob"))
+}
+
+/// `PROBE_SUM=wpns`: weak proof numbers (max + k - 1 instead of the sum).
+pub(crate) fn sum_wpns_arm() -> bool {
+    static F: OnceLock<bool> = OnceLock::new();
+    *F.get_or_init(|| env_eq("PROBE_SUM", "wpns"))
+}
+
+/// `PROBE_SALT=<u64>`: TT index perturbation; 0/unset = baseline.
+pub(crate) fn tt_salt() -> u64 {
+    static F: OnceLock<u64> = OnceLock::new();
+    *F.get_or_init(|| env_u64("PROBE_SALT", 0))
+}
+
+/// `PROBE_CHUNK0=<u64>`: initial work-chunk size for `bounded_search`.
+pub(crate) fn chunk0() -> u64 {
+    static F: OnceLock<u64> = OnceLock::new();
+    *F.get_or_init(|| env_u64("PROBE_CHUNK0", 500_000))
+}
